# Crowdsourcing Auto-Response Agent - Configuration

# ✅ クラウドワークス認証情報
CLOUDWORKS_EMAIL=your_cloudworks_email@example.com
CLOUDWORKS_PASSWORD=your_cloudworks_password

# ✅ ココナラ認証情報
COCONALA_EMAIL=your_coconala_email@example.com
COCONALA_PASSWORD=your_coconala_password

# ✅ Notion API（オプション：返信状況をNotionに自動記録）
NOTION_API_KEY=your_notion_api_key
NOTION_DATABASE_ID=your_notion_database_id

# ✅ 監視設定
MONITOR_INTERVAL_MINUTES=60  # 何分ごとに監視するか
AUTO_RESPOND_MIN_BUDGET=20000  # 最小単価（これ以上の案件のみ返信）
AUTO_RESPOND_CATEGORIES=AI開発,営業代行,マーケティング  # カンマ区切り

# ✅ ログ設定
LOG_LEVEL=INFO
LOG_DIR=../logs

# ✅ 使用ブラウザ
BROWSER_HEADLESS=true  # false にするとブラウザUIを表示
BROWSER_TIMEOUT_SECONDS=30
